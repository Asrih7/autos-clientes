{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"moduleResolution": "node",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "es2015",
		"module": "esnext",
		"lib": ["es2020", "dom"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@mnv-autos-clientes/core": ["libs/core/src/index.ts"],
			"@mnv-autos-clientes/data": ["libs/data/src/index.ts"],
			"@mnv-autos-clientes/features": ["libs/features/src/index.ts"],
			"@mnv-autos-clientes/shared": ["libs/shared/src/index.ts"],
			"@mnv-autos-clientes/ui": ["libs/ui/src/index.ts"],
			"@mnv-autos-clientes/ui/button-example": ["libs/ui/button-example/src/index.ts"]
		}
	},
	"exclude": ["node_modules", "tmp"]
}
